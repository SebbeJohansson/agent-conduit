{
  "name": "agent-conduit",
  "version": "0.3.0",
  "description": "Reads what Claude Code and OpenCode sessions are doing, for apps that show them and later act on them",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebbeJohansson/agent-conduit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "agent-conduit": "bin/agent-conduit.mjs"
  },
  "files": [
    "dist",
    "bin",
    "hooks"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "~5.9",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
